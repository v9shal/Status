{
  "name": "statuspage-backend",
  "version": "1.0.0",
  "description": "Real-time status page API: Express + Postgres + Redis queue/pub-sub + Socket.IO + SMTP worker pool",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc && cp -r src/lua dist/src/lua",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "bench:backoff": "tsx bench/backoff.bench.ts",
    "bench:queue": "tsx bench/queue.bench.ts",
    "bench": "npm run bench:backoff && npm run bench:queue"
  },
  "keywords": [
    "status-page",
    "incidents",
    "redis",
    "websocket",
    "queue"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.11.0",
    "nodemailer": "^8.0.9",
    "socket.io": "^4.8.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.19",
    "@types/nodemailer": "^6.4.23",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  }
}
